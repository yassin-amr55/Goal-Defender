rules_version = '2';

// Firestore security rules for Goal Defender.
//
// WHY THIS FILE MATTERS MORE THAN THE CONFIG
// The firebaseConfig object in player.js ships inside the game bundle and is
// readable by anyone. These rules are the only thing standing between a bored
// visitor and a leaderboard full of 999,999,999 scores. Do not deploy with the
// default test-mode rules open, and do not switch these to `allow read, write`.
//
// The client (player.js / account.js) already refuses implausible values and
// only writes on improvement. These rules repeat those checks, because a
// client-side check is a courtesy, not a defence - anyone can call
// firebase.firestore() directly from the console.
//
// Layout note: shared helpers are declared ABOVE both match blocks so their
// scope is unambiguous. Firestore scopes functions lexically, and relying on a
// declaration that appears later is not something to bet a database on.
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- shared helpers ---------------- */

    // Only the signed-in owner may touch their own document. Anonymous auth
    // gives every visitor a uid, so this already stops one player editing
    // another's row without needing accounts or email.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /* Anonymous auth is the LEADERBOARD's identity - it gives every visitor an
     * id with no login wall. It must NOT be enough to own an account document.
     *
     * The client now refuses to create an account for an anonymous session
     * (see restore() and afterAuth() in account.js). That is a courtesy, not a
     * defence: anyone can call firebase.firestore() from the console, so the
     * rule has to be here too. Without it, one junk account document per
     * visitor was creatable, each holding a copy of their local save - and
     * accounts is owner-only, so nobody could list or remove them. */
    function isRealUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isInt(v) {
      return v is int;
    }

    function within(v, lo, hi) {
      return isInt(v) && v >= lo && v <= hi;
    }

    /* ---------------- accounts (Part 8) ----------------
     *
     * A player's save is PRIVATE: nobody reads it, not even other players.
     * Not even the leaderboard can see it. Writes are owner-only, and the save
     * map is capped so an account document cannot be used as free storage. */
    match /accounts/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isRealUser() && isOwner(uid) && validAccount();
      allow update: if isRealUser() && isOwner(uid) && validAccount();
      allow delete: if false;

      function validAccount() {
        return request.resource.data.keys().hasOnly([
          'username', 'email', 'save', 'createdAt', 'updatedAt', 'lastLogin'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 14
        && request.resource.data.save is map
        /* Cap the save map so an account cannot be used as free storage.
         *
         * This was 20 while account.js whitelisted 15 keys, so it had real
         * headroom. Then SAVE_KEYS grew to 26 (the tournament and tutorial
         * keys were added so a bracket survives a device change) and the cap
         * became a live bug: a player with a full save - anyone who owns a
         * ball or has won a cup - crossed 20 and EVERY account write was
         * denied. Sign-up, sync and rename all failed with permission-denied
         * for exactly the players who had played the most, and it would have
         * looked like the account system was broken rather than the cap being
         * stale.
         *
         * 40 leaves room for the keys above to grow again without touching
         * this file, while still bounding the document. The hasOnly() list
         * above is what actually limits WHICH keys may be written; this only
         * caps how many. Keep the two in step: check SAVE_KEYS in account.js
         * when adding a synced key. */
        && request.resource.data.save.size() <= 40;
      }
    }

    /* ---------------- leaderboard players (Part 6) ----------------
     *
     * Reads are PUBLIC so anyone can view the board. Writes are locked down
     * per player, and the numeric ranges are deliberately generous but not
     * absurd. The name is capped so a player cannot stuff a paragraph into the
     * board. */
    match /players/{playerId} {
      allow read: if true;
      // isOwner() rather than isRealUser(): the leaderboard is deliberately
      // anonymous, and a signed-in player publishes under their ACCOUNT uid so
      // one person is always exactly one row.
      allow create: if isOwner(playerId)
                    && validFields()
                    && validSize();
      allow update: if isOwner(playerId)
                    && validFields()
                    && validSize();
      allow delete: if false;   // rows are never removed by the client

      // Reject any document carrying fields the game does not write. This stops
      // junk such as a nested object smuggled in alongside the score.
      function validFields() {
        return request.resource.data.keys().hasOnly([
          'name', 'highScore', 'deflections', 'trophies', 'updatedAt'
        ]);
      }

      function validSize() {
        return within(request.resource.data.highScore, 0, 1000000)
          && within(request.resource.data.deflections, 0, 100000000)
          && within(request.resource.data.trophies, 0, 9999)
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 14;
      }
    }

    // Anything not matched above is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
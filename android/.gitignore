# Signing material. A keystore or its passwords in a repository is a leaked
# signing key: anyone with a clone can build an update that Play accepts as yours.
*.jks
*.keystore
keystore.properties
local.properties

# google-services.json carries the Firebase project id and API keys. Harmless in
# isolation because firestore.rules is the real defence, but it is per-project
# configuration and does not belong in a public repo.
app/google-services.json

# Build output
.gradle/
build/
app/build/
captures/
.cxx/

# IDE
.idea/
*.iml
local.properties
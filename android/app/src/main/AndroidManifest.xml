<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game is offline-first, but accounts, the leaderboard and the
         trophy room all talk to Firebase. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The Activity is locked to landscape; see the comment above it. The game
         itself still reflows for any aspect ratio the phone hands it, and
         DESIGN.md records the measurements the layout was checked against. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.GoalDefender">

        <!-- Orientation is declared loosely HERE and locked in code instead.
                 Play Console rejected the release that declared
                 android:screenOrientation="landscape":
                     "This release no longer supports 13 devices that were
                      supported in your previous release."
                 For an app targeting API 31+, Google Play removes from the
                 supported-device catalogue any device that cannot honour a fixed
                 orientation - every tablet and foldable, because Android 12+ is
                 free to ignore orientation on displays of 600dp and up. So a
                 manifest lock does not merely rotate the phone; it deletes
                 devices from the store listing, which is a far bigger cost than
                 the portrait-launch problem it solved.

                 So the manifest says "follow the user" and MainActivity calls
                 setRequestedOrientation(LANDSCAPE) in onCreate. The app still
                 opens landscape on every phone, which is the reported bug, and
                 Play still counts every device as supported, because Play's
                 calculation reads the manifest and knows nothing about a runtime
                 call.

                 On a tablet that ignores the request the game simply runs at
                 whatever orientation the player chooses. That is correct: the
                 game is 1280x720 and reflows to any aspect ratio.

                 tools/verify-entry-point.js fails the build if a fixed
                 orientation ever goes back into the manifest, because the device
                 loss is silent - the build stays green and only Play complains.
                 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- google-services.json must NOT be committed. See android/README.md. -->
    </application>
</manifest>
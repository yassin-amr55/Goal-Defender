<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Fullscreen, no action bar, navy window background so the transition into
         the WebView does not flash white. -->
    <style name="Theme.GoalDefender" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/gd_navy</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/gd_navy</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/gd_navy</item>
    </style>
</resources>